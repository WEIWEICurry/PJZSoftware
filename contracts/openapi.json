          }
        },
        "summary": "Accounts"
      },
      "post": {
        "operationId": "create_account_api_v1_accounts_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 20,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
